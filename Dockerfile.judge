FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    openjdk-17-jdk \
    python3 \
    python3-pip \
    gcc \
    g++ \
    make \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 judgeuser

WORKDIR /code

RUN chown -R judgeuser:judgeuser /code

USER judgeuser

CMD ["/bin/bash"]
